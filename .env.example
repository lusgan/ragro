VOYAGE_API_KEY=your_key_here
# Local (docker compose): http://localhost:6333, sem API key
# Qdrant Cloud: URL do cluster (https://xxxxx.cloud.qdrant.io) + API key gerada no dashboard
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Postgres do Supabase — pegue a connection string (modo "Session pooler")
# em Project Settings > Database no dashboard do Supabase.
DATABASE_URL=postgresql+psycopg://postgres:your_password@your_host:5432/postgres
# Chave aleatória usada para assinar o cookie de sessão do login.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_KEY=change_me_to_a_random_secret

# Vertex AI (geração de resposta) — projeto GCP com billing habilitado
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
# base64 do JSON de uma service account com role roles/aiplatform.user:
#   gcloud iam service-accounts keys create key.json --iam-account=SA_EMAIL
#   base64 -w0 key.json
GCLOUD_SA_BASE64=your_base64_encoded_service_account_json