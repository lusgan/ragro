VOYAGE_API_KEY=your_key_here
QDRANT_URL=http://localhost:6333

# Vertex AI (geração de resposta) — projeto GCP com billing habilitado
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
# base64 do JSON de uma service account com role roles/aiplatform.user:
#   gcloud iam service-accounts keys create key.json --iam-account=SA_EMAIL
#   base64 -w0 key.json
GCLOUD_SA_BASE64=your_base64_encoded_service_account_json